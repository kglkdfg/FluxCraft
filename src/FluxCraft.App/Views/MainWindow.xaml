<Window x:Class="FluxCraft.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FluxCraft" Height="720" Width="1120"
        MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}"
        Foreground="#F2F3F7">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#1D2027" Padding="20">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="FLUXCRAFT" FontSize="22" FontWeight="Bold" Margin="0,4,0,28"/>
                    <Button Content="Мои сборки" Padding="12" HorizontalContentAlignment="Left" Margin="0,0,0,8"/>
                    <Button Content="Настройки" Padding="12" HorizontalContentAlignment="Left"/>
                </StackPanel>
                <TextBlock DockPanel.Dock="Bottom" Text="Minecraft Launcher • .NET 8" Foreground="#9298A7" FontSize="11"/>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1" Margin="32">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <StackPanel>
                <TextBlock Text="Мои сборки" FontSize="28" FontWeight="SemiBold"/>
                <TextBlock Text="Управляй версиями Minecraft в одном месте."
                           Foreground="#A8ADBA" Margin="0,8,0,0"/>
            </StackPanel>

            <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}" CornerRadius="12"
                    Padding="24" Margin="0,28,0,28">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="Пока здесь пусто" FontSize="20" FontWeight="SemiBold"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="Создай первую сборку — здесь появятся её версия, загрузчик и настройки."
                               Foreground="#A8ADBA" TextWrapping="Wrap" TextAlignment="Center"
                               MaxWidth="430" Margin="0,10,0,20"/>
                    <Button Content="Создать сборку" Padding="20,10" Background="{StaticResource AccentBrush}"
                            Foreground="White" BorderThickness="0" FontWeight="SemiBold"/>
                </StackPanel>
            </Border>

            <TextBlock Grid.Row="2" Text="Готов к настройке первой сборки"
                       Foreground="#9298A7" HorizontalAlignment="Right"/>
        </Grid>
    </Grid>
</Window>
